"[{\"AllowMultiple\":false,\"EndLine\":204,\"ReplacementContent\":\"\",\"StartLine\":171,\"TargetContent\":\"// ==========================================================================\\n// DYNAMIC LIVE CLOCK (IST Timezone)\\n// ==========================================================================\\nlet clockInterval;\\n\\nfunction startLiveClock() {\\n  if (clockInterval) {\\n    clearInterval(clockInterval);\\n  }\\n\\n  const clockEl = document.getElementById('live-clock');\\n  if (!clockEl) return;\\n\\n  function updateClock() {\\n    const options = {\\n      timeZone: 'Asia/Kolkata',\\n      hour: '2-digit',\\n      minute: '2-digit',\\n      second: '2-digit',\\n      hour12: true\\n    };\\n    \\n    try {\\n      const formatter = new Intl.DateTimeFormat('en-US', options);\\n      clockEl.textContent = formatter.format(new Date());\\n    } catch (err) {\\n      clockEl.textContent = new Date().toLocaleTimeString();\\n    }\\n  }\\n\\n  updateClock();\\n  clockInterval = setInterval(updateClock, 1000);\\n}\"},{\"AllowMultiple\":false,\"EndLine\":316,\"ReplacementContent\":\"initTheme();\\ninitThemeToggler();\\ninitTypewriter();\\ninitScrollReveal();\\ninitInteractiveBio();\",\"StartLine\":310,\"TargetContent\":\"initTheme();\\ninitThemeToggler();\\ninitTypewriter();\\ninitScrollReveal();\\nstartLiveClock();\\ninitInteractiveBio();\"}]"