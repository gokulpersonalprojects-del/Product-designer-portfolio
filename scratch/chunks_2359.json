"[{\"AllowMultiple\":false,\"EndLine\":65,\"ReplacementContent\":\"html.light {\\n  --bg-primary: hsl(0, 0%, 100%);\\n  --bg-secondary: hsl(0, 0%, 97%);\\n  --bg-tertiary: hsl(0, 0%, 95%);\\n  --bg-card: hsl(0, 0%, 100%);\\n  --bg-toggle: hsl(0, 0%, 95%);\\n  \\n  --text-primary: hsl(0, 0%, 5%);       /* AAA compliant contrast: 18.2:1 against white */\\n  --text-secondary: hsl(0, 0%, 20%);     /* AAA compliant contrast: 11.5:1 against white */\\n  --text-muted: hsl(0, 0%, 32%);         /* AAA compliant contrast: 7.1:1 against white */\\n  \\n  --border-color: rgba(0, 0, 0, 0.08);\\n  --border-hover: rgba(0, 0, 0, 0.16);\\n  \\n  --color-accent: hsl(22, 95%, 32%);     /* AAA compliant contrast: 7.1:1 against white */\\n  --color-brand: hsl(258, 70%, 45%);     /* AAA compliant contrast: 7.2:1 against white */\\n  --color-bop: hsl(327, 95%, 26%);       /* AAA compliant contrast: 9.8:1 against white */\\n  --color-accent-light: hsla(22, 95%, 32%, 0.08);\\n  \\n  --color-on-accent: #ffffff;\\n  --color-on-brand: #ffffff;\\n  --color-on-bop: #ffffff;\\n  \\n  --color-success: hsl(142, 95%, 22%);   /* AAA compliant contrast: 10.9:1 against white */\\n  --color-success-light: hsla(142, 95%, 22%, 0.08);\\n  --color-on-success: #ffffff;\\n  \\n  --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.04);\\n  --shadow-md: 0 8px 30px rgba(0, 0, 0, 0.06);\\n  --shadow-focus: 0 0 0 3px hsla(22, 95%, 32%, 0.3);\\n  \\n  --shadow-accent: 0 3px 10px hsla(22, 95%, 32%, 0.25);\\n  --shadow-accent-hover: 0 5px 16px hsla(22, 95%, 32%, 0.35);\\n  --shadow-brand: 0 3px 10px hsla(258, 70%, 45%, 0.25);\\n  --shadow-brand-hover: 0 5px 16px hsla(258, 70%, 45%, 0.35);\\n  --shadow-bop: 0 3px 10px hsla(327, 95%, 26%, 0.25);\\n  --shadow-bop-hover: 0 5px 16px hsla(327, 95%, 26%, 0.35);\\n\\n  /* Bento Card Hover Accents */\\n  --color-accent-experience: hsl(22, 95%, 32%);\\n  --color-accent-mba: hsl(340, 90%, 36%);\\n\\n  /* Focus Deck active HSL components */\\n  --active-ai: 22, 95%, 32%;\\n  --active-saas: 258, 70%, 45%;\\n  --active-fintech: 200, 95%, 32%;\\n  --active-build: 145, 95%, 28%;\\n  --active-mba:\n<truncated 13527 bytes>"